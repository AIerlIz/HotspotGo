<Project Sdk="Microsoft.NET.Sdk">

  <!--
    登录 / 开机自动开启 Windows 移动热点。

    ★ 为什么是 net48 而不是 .NET 8:
      .NET Framework 的 CLR **内建 WinRT 互操作**,可以直接按
      "类型全名, 程序集名, ContentType=WindowsRuntime" 解析 WinRT 类型,
      因此**不需要随程序分发 Microsoft.Windows.SDK.NET.dll**(约 24 MB)。
      .NET 5+ 没有这个能力,必须带那个投影程序集。

      收益:产物约 40 KB(Release 实测 40960 字节:图标约 15 KB,终端 / 版本支持约 5 KB),
      且 Win10/11 自带 .NET Framework 4.8,目标机零安装。
      (加图标前是 20480 字节。图标只放 16/32/48/256 四个尺寸就是为了这个:
       ICO 里的 64 / 128 是未压缩位图,光 128 一张就 65 KB —— 体积是这个项目的一个卖点,
       不该为了图标把它翻几倍。要改图标见 scripts/make-icon.py。)

    ★ 输出路径用 SDK 默认的 bin\Release\net48\(与目标框架一致,不再有历史遗留目录名)。
      计划任务要指向本 exe 时,以这里的实际输出路径为准。
  -->
  <PropertyGroup>
    <!--
      ★ 为什么是控制台子系统(Exe)而不是 WinExe:
        这决定了"从终端里跑"这件事成不成立。WinExe 是 GUI 子系统,shell 不会等它 ——
        实测进程真实跑 125ms,而 PowerShell 的 & 调用 3ms 就返回了,于是输出落在提示符
        之后,$LASTEXITCODE 也拿不到(还是上一条命令的值)。换成控制台子系统后,
        shell 正常等待,管道 / 重定向 / 退出码才都成立。

        代价是双击 / 启动文件夹启动时 Windows 会新建一个控制台窗口 —— 那正是这台工具
        要避免的(开机自启弹黑窗)。所以启动第一件事就是判断这个控制台是哪来的,
        是系统为我们新建的就藏掉窗口,是从 cmd / PowerShell 继承来的就绝不碰
        —— 见 src/HotspotGo/Cli/Terminal.cs(判别规则有单元测试钉着)。
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HotspotGo</AssemblyName>
    <RootNamespace>HotspotGo</RootNamespace>

    <!-- 固定 x64:热点 API 在 32 位下也能用,但本项目只按 64 位 Windows 验证与发布,
         固定下来可以避开 AnyCPU 那套(64 位系统上的 WinExe 默认 Prefer32Bit,
         同一个 exe 在不同机器上会跑成两种进程形态),少一个变量。 -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- 图标:由 scripts/make-icon.py 生成(改配色 / 换形状就去改那个脚本重跑,
         别直接编辑 .ico —— 二进制文件没有来源就没人敢动它) -->
    <ApplicationIcon>Assets\HotspotGo.ico</ApplicationIcon>

    <!-- 文件属性里显示的东西。用户排查问题时第一眼就是右键→属性→详细信息 -->
    <AssemblyTitle>热点快启 HotspotGo</AssemblyTitle>
    <Product>热点快启 HotspotGo</Product>
    <Description>一键打开 Windows 移动热点(命令行,无内置界面)。</Description>

    <!-- 版本号刻意不写死在这里:release.yml 会按 tag 注入
         (-p:Version=1.2.3),这样 exe 的文件版本与发布的 tag 一致 ——
         否则每一个 Release 的 exe 都写着 1.0.0,用户没法判断自己下的是哪一版。
         这里不填 = 本地构建用 SDK 默认的 1.0.0;发布流水线里有一道核对,版本对不上会直接失败。 -->
    <!-- 不生成 .exe.config:net48 默认会写一份 supportedRuntime 声明,
         而 v4.0 是本机唯一可用的 CLR,这份声明没有任何作用 -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- 让 dotnet build 在没有 Visual Studio / Win10 SDK 的机器上也能编译 net48 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      本程序集的类型全部是 internal(单入口的桌面小工具,没必要对外暴露 API),
      因此测试程序集需要显式授权才能访问。

      注意这只写进元数据,不产生任何程序集引用,不影响产物体积与运行时依赖。
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HotspotGo.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
